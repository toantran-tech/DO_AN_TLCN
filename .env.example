# Database configuration
POSTGRES_DB=washgo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5432

# Backend configuration
BE_PORT=5000

# Official payment gateway sandbox (Live = connect to gateway; not production).
PAYMENT_PROVIDER=Live
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/swagger/index.html
# Register this public HTTPS URL in the VNPay sandbox portal; not a backend setting.
VNPAY_IPN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=payWithMethod
MOMO_REDIRECT_URL=http://localhost:5000/swagger/index.html
MOMO_IPN_URL=
JWT_SECRET_KEY=WashGo_Super_Secret_Key_For_Jwt_Token_Generation_2026!#@$

# Admin UI configuration
ADMIN_PORT=5173

# Google Sign-In
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# SMTP Email configuration (OTP & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_SENDER_ADDRESS=your-email@gmail.com
SMTP_SENDER_NAME=WashGo
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password

# Gemini chatbot - keep the real key only in .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
