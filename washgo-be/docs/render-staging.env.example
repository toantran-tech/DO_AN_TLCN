# Render Environment > Add from .env. Replace placeholders privately before saving.
# Do not commit an actual environment file containing keys/passwords.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_HTTP_PORTS=8080
PORT=8080
Seeding__Enabled=false
ConnectionStrings__Default=Host=<NEON_DIRECT_HOST>;Port=5432;Database=neondb;Username=neondb_owner;Password=<NEON_PASSWORD>;SSL Mode=Require;
Jwt__SecretKey=<GENERATE_A_NEW_PRIVATE_RANDOM_KEY>
App__PublicBaseUrl=https://<YOUR_RENDER_HOST>
App__CorsOrigins=http://localhost:5173,http://localhost:3000,https://<YOUR_FRONTEND_HOST>

# HTTPS transactional email; sender must first be verified with Brevo.
Email__Provider=Brevo
Email__Brevo__ApiKey=<BREVO_API_KEY>
Email__SenderAddress=<VERIFIED_SENDER_EMAIL>
Email__SenderName=WashGo

# Create two PRIVATE Supabase Storage buckets. Use a backend-only legacy service_role key.
Storage__Provider=Supabase
Storage__Supabase__Url=https://<PROJECT_REF>.supabase.co
Storage__Supabase__ServiceRoleKey=<SUPABASE_SERVICE_ROLE_KEY>
Storage__Supabase__UploadsBucket=washgo-uploads
Storage__Supabase__DocumentsBucket=washgo-documents

# Application options, not the variable names used by local docker-compose interpolation.
Google__ClientId=<GOOGLE_WEB_CLIENT_ID>
Chatbot__Gemini__ApiKey=<GEMINI_API_KEY>

# Official sandbox gateways. No Mock provider on public staging.
Payment__Provider=Live
Payment__VnPay__TmnCode=<VNPAY_SANDBOX_TMN_CODE>
Payment__VnPay__HashSecret=<VNPAY_SANDBOX_HASH_SECRET>
Payment__VnPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Payment__VnPay__ReturnUrl=https://<YOUR_RENDER_HOST>/payment/return
# Register https://<YOUR_RENDER_HOST>/payment/vnpay-ipn with VNPay merchant settings.
Payment__Momo__PartnerCode=<MOMO_SANDBOX_PARTNER_CODE>
Payment__Momo__AccessKey=<MOMO_SANDBOX_ACCESS_KEY>
Payment__Momo__SecretKey=<MOMO_SANDBOX_SECRET_KEY>
Payment__Momo__Endpoint=https://test-payment.momo.vn/v2/gateway/api/create
Payment__Momo__RequestType=payWithMethod
Payment__Momo__RedirectUrl=https://<YOUR_RENDER_HOST>/payment/return
Payment__Momo__IpnUrl=https://<YOUR_RENDER_HOST>/payment/momo-ipn
