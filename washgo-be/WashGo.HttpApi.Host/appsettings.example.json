{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=washgo_db;Username=postgres;Password=CHANGE_ME;Include Error Detail=true;"
  },
  "App": {
    "SelfUrl": "https://localhost:7001",
    "CorsOrigins": "http://localhost:5173,http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "WashGoBackend",
    "Audience": "WashGoClients",
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "AccessTokenExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 30
  },
  "Google": {
    "ClientId": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
  },
  "Email": {
    "Mode": "Smtp",
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "EnableSsl": true,
      "SenderAddress": "noreply@example.com",
      "SenderName": "WashGo",
      "Username": "SET_FROM_SMTP_PROVIDER",
      "Password": "SET_FROM_SMTP_PROVIDER"
    }
  },
  "Payment": {
    "Provider": "Mock",
    "VnPay": {
      "TmnCode": "SET_FROM_VNPAY_PORTAL",
      "HashSecret": "SET_FROM_VNPAY_PORTAL",
      "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
      "ReturnUrl": "https://your-public-domain/payment/return"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Volo.Abp": "Information"
    }
  },
  "AllowedHosts": "*"
}
